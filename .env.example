# Silogtran
SILOG_BASE_URL=https://construproyec.colombiasoftware.net
SILOG_USER=
SILOG_PASSWORD=

# Static key required in the x-api-key header. Generate: openssl rand -hex 32
API_KEY=

# Supabase (server only; service_role/secret key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional
# WAF_CHROME_PATH=/usr/bin/chromium   # local only; on Vercel @sparticuz/chromium is used
# WAF_WAIT_SEC=30
# SILOG_TIMEOUT_SEC=45

# Secret to sign the `preparar` token (HMAC). Generate: openssl rand -hex 32 (different from API_KEY)
TOKEN_SECRET=

# Multi-user (M1). Generate each with: openssl rand -hex 32 (all different from each other)
# ENCRYPTION_KEY: 64 hex chars; encrypts users' Silogtran passwords at rest
ENCRYPTION_KEY=
# ADMIN_KEY: protects /api/admin/* (header x-api-key); different from API_KEY
ADMIN_KEY=

# WhatsApp bot number, digits only with country code (used for the "Abrir WhatsApp" button), e.g. 57XXXXXXXXXX (the NEW number of this bot, not SICE Query's)
WHATSAPP_NUMBER=

# WhatsApp Cloud API (webhook + replies). All from your Meta app; never commit values.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
# Optional: WHATSAPP_API_VERSION=v23.0   PUBLIC_BASE_URL=https://auto-despachos-silogtran.vercel.app

# AI assistant (OpenAI): conversation + voice notes. Same variable names as SICE Query where they exist.
# OPENAI_API_KEY (or IA_API_KEY): without it the bot keeps working but says the assistant is not enabled.
OPENAI_API_KEY=
# Optional: IA_MODELO=gpt-4.1-mini  IA_MODELO_RESPALDO=gpt-4o-mini  STT_MODELO=gpt-4o-mini-transcribe
# Optional hourly limits per user: IA_MAX_MSG_HORA=40  IA_MAX_VOZ_HORA=15

# Activation MCP (/api/mcp). MCP_KEY: >= 24 chars, different from the other keys; it is what you type on the authorize page (OAuth) or send as Bearer.
# Rotating it revokes every issued OAuth token. MCP_ACTOR (optional): Silogtran user / app user id used for the activations (empty = user zero).
MCP_KEY=
# MCP_ACTOR=
